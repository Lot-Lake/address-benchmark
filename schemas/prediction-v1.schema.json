{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:address-benchmark:prediction:v1",
  "title": "Native prediction envelope v1; task semantics require executable checks",
  "type": "object",
  "required": ["schema", "id", "input_sha256", "status", "native", "evidence", "tokens", "inferred", "normalized"],
  "properties": {
    "schema": {"const": "address-benchmark.prediction/v1"},
    "id": {"type": "string"},
    "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "status": {"enum": ["ok", "error", "refused"]},
    "message": {"type": "string", "minLength": 1},
    "native": {},
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/item"}},
    "tokens": {"type": "array", "items": {"$ref": "#/$defs/item"}},
    "inferred": {"type": "array"},
    "normalized": {"type": "array", "items": {"type": "string"}},
    "profile": {"type": "string"},
    "keys": {"type": "array", "items": {"type": "string"}},
    "result": {}
  },
  "allOf": [{"if": {"properties": {"status": {"enum": ["error", "refused"]}}}, "then": {"required": ["message"], "properties": {"evidence": {"maxItems": 0}, "tokens": {"maxItems": 0}}}}],
  "$defs": {
    "span": {"type": "array", "prefixItems": [{"type": "integer", "minimum": 0}, {"type": "integer", "minimum": 1}], "minItems": 2, "maxItems": 2},
    "item": {"type": "object", "required": ["native_role", "value"], "properties": {"native_role": {"type": "string"}, "value": {"type": "string"}, "spans": {"oneOf": [{"type": "null"}, {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/span"}}]}}}
  }
}
