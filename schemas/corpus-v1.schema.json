{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:address-benchmark:corpus:v1",
  "title": "Address benchmark corpus manifest v1",
  "type": "object",
  "required": [
    "schema",
    "id",
    "version",
    "country",
    "locale",
    "task",
    "provenance",
    "license",
    "construction",
    "ontology",
    "annotation_policy",
    "exposure",
    "resources",
    "split_policy",
    "family_policy"
  ],
  "properties": {
    "schema": {
      "const": "address-benchmark.corpus/v1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "country": {
      "const": "US"
    },
    "locale": {
      "type": "string",
      "minLength": 1
    },
    "task": {
      "enum": [
        "parse",
        "normalize",
        "match",
        "format",
        "classify",
        "extract",
        "infer",
        "variants",
        "diagnostics",
        "stability"
      ]
    },
    "profile": {
      "type": "string",
      "minLength": 1
    },
    "ontology": {
      "type": "string"
    },
    "annotation_policy": {
      "type": "string",
      "minLength": 1
    },
    "split_policy": {
      "type": "string",
      "minLength": 1
    },
    "family_policy": {
      "type": "string",
      "minLength": 1
    },
    "provenance": {
      "type": "object",
      "required": [
        "source",
        "upstream_revision"
      ],
      "properties": {
        "source": {
          "type": "string"
        },
        "upstream_revision": {
          "type": "string"
        },
        "source_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "license": {
      "type": "object",
      "required": [
        "spdx",
        "redistribution"
      ],
      "properties": {
        "spdx": {
          "type": "string"
        },
        "redistribution": {
          "enum": [
            "allowed",
            "local-only"
          ]
        }
      }
    },
    "construction": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "exposure": {
      "type": "object",
      "required": [
        "status",
        "history"
      ],
      "properties": {
        "status": {
          "type": "string"
        },
        "history": {
          "type": "array"
        }
      }
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "url": {
            "type": "string",
            "pattern": "^https://"
          },
          "external_path": {
            "type": "string",
            "pattern": "^/"
          },
          "format": {
            "enum": [
              "geosearch-reference",
              "expanded-parser",
              "doorplate-compare",
              "usaddress-xml",
              "input-panel"
            ]
          },
          "split": {
            "type": "string"
          },
          "origin": {
            "enum": [
              "natural",
              "authored",
              "generated",
              "source-field-supervised",
              "publisher-fixture"
            ]
          },
          "coverage": {
            "const": "partial"
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "annotation_scope": {
            "$ref": "#/$defs/annotation_scope"
          }
        },
        "oneOf": [
          {
            "required": [
              "path"
            ],
            "not": {
              "required": [
                "external_path"
              ]
            }
          },
          {
            "required": [
              "external_path"
            ],
            "not": {
              "required": [
                "path"
              ]
            }
          }
        ]
      }
    },
    "row_limit": {
      "type": "integer",
      "minimum": 1
    },
    "scoring_profiles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "strict-streetline/v1",
          "strict-streetline/v2"
        ]
      }
    },
    "scorer": {
      "enum": [
        "address-benchmark.scorer/v1",
        "address-benchmark.scorer/v2"
      ]
    },
    "preservation_cohorts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "basis"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "basis": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind"
                ],
                "properties": {
                  "kind": {
                    "enum": [
                      "external",
                      "baseline-correct"
                    ]
                  },
                  "metric": {
                    "enum": [
                      "strict",
                      "delimiter",
                      "strict-streetline/v1",
                      "strict-streetline/v2"
                    ]
                  },
                  "splits": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "subset": {
                    "type": "string",
                    "minLength": 1
                  },
                  "baseline_pin": {
                    "$ref": "#/$defs/sha256"
                  }
                }
              }
            ]
          },
          "row_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "basis": {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "const": "baseline-correct"
                    }
                  },
                  "required": [
                    "kind"
                  ]
                }
              }
            },
            "then": {
              "not": {
                "required": [
                  "row_ids"
                ]
              }
            },
            "else": {
              "required": [
                "row_ids"
              ]
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "annotation_layer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coverage",
        "roles",
        "absence"
      ],
      "properties": {
        "coverage": {
          "enum": [
            "complete",
            "partial",
            "none"
          ]
        },
        "roles": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "absence": {
          "type": "boolean"
        }
      }
    },
    "annotation_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fields",
        "tokens",
        "spans"
      ],
      "properties": {
        "fields": {
          "$ref": "#/$defs/annotation_layer"
        },
        "tokens": {
          "$ref": "#/$defs/annotation_layer"
        },
        "spans": {
          "$ref": "#/$defs/annotation_layer"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "resources": {
            "contains": {
              "required": [
                "external_path"
              ]
            }
          }
        }
      },
      "then": {
        "properties": {
          "license": {
            "properties": {
              "redistribution": {
                "const": "local-only"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "scorer"
        ],
        "properties": {
          "scorer": {
            "const": "address-benchmark.scorer/v2"
          }
        }
      },
      "then": {
        "properties": {
          "task": {
            "const": "parse"
          },
          "resources": {
            "items": {
              "required": [
                "annotation_scope"
              ]
            }
          }
        }
      },
      "else": {
        "properties": {
          "resources": {
            "items": {
              "not": {
                "required": [
                  "annotation_scope"
                ]
              }
            }
          }
        }
      }
    }
  ]
}
