{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:address-benchmark:corpus:v1",
  "title": "Address benchmark corpus manifest v1",
  "type": "object",
  "required": [
    "schema",
    "id",
    "version",
    "country",
    "locale",
    "task",
    "provenance",
    "license",
    "construction",
    "ontology",
    "annotation_policy",
    "exposure",
    "resources",
    "split_policy",
    "family_policy"
  ],
  "properties": {
    "schema": {
      "const": "address-benchmark.corpus/v1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "country": {
      "const": "US"
    },
    "locale": {
      "type": "string",
      "minLength": 1
    },
    "task": {
      "enum": [
        "parse",
        "normalize",
        "match",
        "format",
        "classify",
        "extract",
        "infer",
        "variants",
        "diagnostics",
        "stability"
      ]
    },
    "profile": {
      "type": "string",
      "minLength": 1
    },
    "ontology": {
      "type": "string"
    },
    "annotation_policy": {
      "type": "string",
      "minLength": 1
    },
    "split_policy": {
      "type": "string",
      "minLength": 1
    },
    "family_policy": {
      "type": "string",
      "minLength": 1
    },
    "provenance": {
      "type": "object",
      "required": [
        "source",
        "upstream_revision"
      ],
      "properties": {
        "source": {
          "type": "string"
        },
        "upstream_revision": {
          "type": "string"
        },
        "source_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "license": {
      "type": "object",
      "required": [
        "spdx",
        "redistribution"
      ],
      "properties": {
        "spdx": {
          "type": "string"
        },
        "redistribution": {
          "enum": [
            "allowed",
            "local-only"
          ]
        }
      }
    },
    "construction": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "exposure": {
      "type": "object",
      "required": [
        "status",
        "history"
      ],
      "properties": {
        "status": {
          "type": "string"
        },
        "history": {
          "type": "array"
        }
      }
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "url": {
            "type": "string",
            "pattern": "^https://"
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
